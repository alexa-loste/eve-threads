# Copy to sidecar/.env (gitignored). Leave EVE_MCP_URL empty to run local-only.

# Eve's MCP endpoint, exactly as shown in Eve's docs / in-app connect card.
# Use this host: the endpoint's OAuth metadata names it, and MCP clients check that it matches.
EVE_MCP_URL=https://eve-product.fly.dev/eve-mcp/mcp

# Cortex that parked threads are written to. Created on first sign-in if missing.
EVE_SPACE=browsing
